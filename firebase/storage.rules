rules_version = '2';

// Voltair Studio Portal — Storage rules.
//   deliverables/{clientId}/...  — studio-uploaded deliverable files; tenant reads
//   attachments/{clientId}/...   — client-attached feedback files; tenant reads + writes
// Both paths carry {clientId} as the first segment so isolation is an O(1) check.

service firebase.storage {
  match /b/{bucket}/o {

    function isSignedIn() {
      return request.auth != null;
    }
    function isAdmin() {
      return isSignedIn() && request.auth.token.role == 'admin';
    }
    function isClientOf(clientId) {
      return isSignedIn()
        && request.auth.token.role == 'client'
        && request.auth.token.clientId == clientId;
    }

    match /deliverables/{clientId}/{allPaths=**} {
      allow read: if isAdmin() || isClientOf(clientId);
      allow write: if isAdmin();
    }

    match /attachments/{clientId}/{allPaths=**} {
      allow read: if isAdmin() || isClientOf(clientId);
      // Client-writable — cap size + type so a leaked client token can't run up
      // the Storage bill or stash arbitrary files.
      allow write: if (isAdmin() || isClientOf(clientId))
        && request.resource.size < 50 * 1024 * 1024
        && request.resource.contentType.matches('image/.*|video/.*|application/pdf');
    }

    // Everything else is denied by default.
  }
}
